# Database Server Connection String (PostgreSQL Server)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/eventhub"

# Konfigurasi Docker PostgreSQL Service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=eventhub
POSTGRES_PORT=5432

# Opsi SSL untuk Cloud Database (true jika menggunakan Neon / Supabase / AWS RDS)
DB_SSL=false

# Public API URL (opsional, default ke relative path di browser)
NEXT_PUBLIC_API_URL=""
