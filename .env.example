# Database Server Connection String (PostgreSQL Server)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# --- OPSI 1: PostgreSQL Server Lokal / Docker ---
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/eventhub"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=eventhub
POSTGRES_PORT=5432
DB_SSL=false

# --- OPSI 2: Supabase Cloud PostgreSQL (Rekomendasi Pooler IPv4 & IPv6) ---
# CATATAN: Gunakan Supavisor Connection Pooler (port 6543 atau 5432) untuk mendukung jaringan IPv4 (Indihome/Telkomsel/Biznet/WiFi).
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Contoh:
# DATABASE_URL="postgresql://postgres.pffhsymesisecmnnofhd:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"
# DB_SSL=true

# Public API URL (opsional, default ke relative path di browser)
NEXT_PUBLIC_API_URL=""
